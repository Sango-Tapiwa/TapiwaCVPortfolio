@model IEnumerable<CVPortfolio.Models.Experience>
@{
    ViewData["Title"] = "Manage Experiences";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold">Manage Experiences</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="CreateExperience" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Experience
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No experiences yet. <a asp-action="CreateExperience">Add one now</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Job Title</th>
                        <th>Company</th>
                        <th>Location</th>
                        <th>Period</th>
                        <th>Status</th>
                        <th>Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.JobTitle</td>
                            <td>@item.Company</td>
                            <td>@(string.IsNullOrEmpty(item.Location) ? "-" : item.Location)</td>
                            <td>@item.StartDate.ToString("MMM yyyy") - @(item.IsCurrent ? "Present" : item.EndDate?.ToString("MMM yyyy"))</td>
                            <td>
                                @if (item.IsCurrent)
                                {
                                    <span class="badge bg-success">Current</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Past</span>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@item.DisplayOrder</span></td>
                            <td>
                                <a asp-action="EditExperience" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="DeleteExperience" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>
