@model CVPortfolio.Models.Experience
@{
    ViewData["Title"] = "Delete Experience";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Delete
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Are you sure you want to delete this experience entry?</p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 fw-bold">Job Title:</dt>
                        <dd class="col-sm-8">@Model.JobTitle</dd>

                        <dt class="col-sm-4 fw-bold">Company:</dt>
                        <dd class="col-sm-8">@Model.Company</dd>

                        <dt class="col-sm-4 fw-bold">Location:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Location) ? "N/A" : Model.Location)</dd>

                        <dt class="col-sm-4 fw-bold">Period:</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToString("MMM yyyy") - @(Model.IsCurrent ? "Present" : Model.EndDate?.ToString("MMM yyyy"))</dd>

                        <dt class="col-sm-4 fw-bold">Status:</dt>
                        <dd class="col-sm-8">@(Model.IsCurrent ? "Current" : "Past")</dd>
                    </dl>

                    <p class="text-danger mb-4">
                        <i class="fas fa-info-circle"></i> This action cannot be undone.
                    </p>

                    <form asp-action="DeleteExperience" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete Permanently
                        </button>
                        <a asp-action="ManageExperiences" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
