@model Skill
@{
    ViewData["Title"] = "Delete Skill";
}

<div class="container py-5">
    <h1 class="mb-4">Delete Skill</h1>

    <div class="alert alert-danger">
        <h5><i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this skill?</h5>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category</dd>

                <dt class="col-sm-3">Display Order</dt>
                <dd class="col-sm-9">@Model.DisplayOrder</dd>
            </dl>
        </div>
    </div>

    <form asp-action="DeleteSkill" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> Confirm Delete
        </button>
        <a asp-action="ManageSkills" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancel
        </a>
    </form>
</div>
