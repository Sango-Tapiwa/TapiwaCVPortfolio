@model List<Skill>
@{
    ViewData["Title"] = "Manage Skills";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Skills</h1>
        <a asp-action="CreateSkill" class="btn btn-success">
            <i class="fas fa-plus"></i> Add New Skill
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Display Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skill in Model)
                    {
                        <tr>
                            <td>@skill.Name</td>
                            <td>@skill.Category</td>
                            <td>@skill.DisplayOrder</td>
                            <td>
                                <a asp-action="EditSkill" asp-route-id="@skill.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="DeleteSkill" asp-route-id="@skill.Id" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No skills added yet. Click "Add New Skill" to get started.
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>
